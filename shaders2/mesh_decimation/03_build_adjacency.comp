#version 460
#extension GL_EXT_shader_atomic_int64 : require

// ============================================================================
// Pass 3: Build Per-Vertex Triangle Adjacency Lists
//
// Dispatch: ceil(triangleCount / WORKGROUP_SIZE) workgroups
// 1 thread per triangle.
//
// For each triangle in PB, atomically prepend it to the linked list of each
// of its 3 vertices. Uses atomicExchange to build lock-free linked lists.
//
// Each entry is packed as (triIdx << 2 | slot), where slot is 0/1/2
// indicating which vertex of the triangle this list entry refers to.
// This allows traversal without looking up posIndices.
//
// Prerequisites:
//   - adjHead[] must be cleared to NONE (0xFFFFFFFF) before dispatch.
//   - posIndices[] (PB) must be populated from Pass 2.
//
// Result:
//   adjHead[v] = packed(firstTri, slot) for vertex v
//   triAdjNext[tri*3 + k] = packed(nextTri, nextSlot) in list for vertex k
// ============================================================================

#include "common.glsl"
#include "bindings.glsl"

layout(local_size_x = WORKGROUP_SIZE) in;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= triangleCount) return;

    uint baseIdx = gid * 3u;

    for (uint k = 0u; k < 3u; k++) {
        uint vertIdx = posIndices[baseIdx + k];

        uint packed = ADJ_PACK(gid, k);
        uint oldHead = atomicExchange(adjHead[vertIdx], packed);
        triAdjNext[gid * 3u + k] = oldHead;
    }
}
