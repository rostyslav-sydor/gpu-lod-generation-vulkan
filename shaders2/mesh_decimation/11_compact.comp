#version 460
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_basic : require

// ============================================================================
// Pass 11: Compact Index Buffers
//
// Dispatch: ceil(triangleCount / WORKGROUP_SIZE) workgroups
// 1 thread per triangle.
//
// Removes degenerate triangles by compacting alive triangles into a
// contiguous output buffer. Uses a two-level approach:
//   1. Subgroup ballot counts alive threads and assigns local indices
//   2. Subgroup leaders do a workgroup-level prefix sum via shared memory
//   3. One thread per workgroup reserves a global output block via atomicAdd
//   4. Alive threads scatter their triangle data to the output
//
// Output is written to scanData[] (repurposed as temp storage).
// Pass 12 copies the result back to indices[]/posIndices[].
//
// Prerequisites:
//   - aliveFlags[] from Pass 10
//   - counters[COUNTER_COMPACT_COUNT] must be 0 before dispatch
//
// Result:
//   - Compacted indices written to scanData[]
//   - counters[COUNTER_COMPACT_COUNT] = new triangle count
// ============================================================================

#include "common.glsl"
#include "bindings.glsl"

layout(local_size_x = WORKGROUP_SIZE) in;

shared uint sgCounts[WORKGROUP_SIZE / 32 + 1];  // per-subgroup alive counts
shared uint sgOffsets[WORKGROUP_SIZE / 32 + 1]; // per-subgroup exclusive prefix
shared uint wgOutputBase;
shared uint wgTotal;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;
    uint subgroupIdx = gl_SubgroupID;

    // Determine if this triangle is alive
    bool alive = false;
    if (gid < triangleCount) {
        alive = (aliveFlags[gid] != 0u);
    }

    // Step 1: Subgroup-level count and prefix
    uvec4 ballot = subgroupBallot(alive);
    uint sgAliveCount = subgroupBallotBitCount(ballot);
    uint sgExclusiveIdx = subgroupBallotExclusiveBitCount(ballot);

    // Step 2: Subgroup leaders write their counts to shared memory
    if (gl_SubgroupInvocationID == 0u) {
        sgCounts[subgroupIdx] = sgAliveCount;
    }
    barrier();

    // Step 3: First subgroup computes exclusive prefix sum of subgroup counts
    uint numSubgroups = (WORKGROUP_SIZE + gl_SubgroupSize - 1u) / gl_SubgroupSize;
    if (subgroupIdx == 0u && gl_SubgroupInvocationID < numSubgroups) {
        uint val = sgCounts[gl_SubgroupInvocationID];
        uint prefix = subgroupExclusiveAdd(val);
        sgOffsets[gl_SubgroupInvocationID] = prefix;

        // Last participating lane writes the workgroup total
        if (gl_SubgroupInvocationID == numSubgroups - 1u) {
            wgTotal = prefix + val;
        }
    }
    barrier();

    // Step 4: First thread reserves global output space
    if (lid == 0u) {
        wgOutputBase = atomicAdd(counters[COUNTER_COMPACT_COUNT], wgTotal);
    }
    barrier();

    // Step 5: Each alive thread writes its triangle to the output
    if (!alive) return;

    uint localIdx = sgOffsets[subgroupIdx] + sgExclusiveIdx;
    uint globalIdx = wgOutputBase + localIdx;

    uint srcBase = gid * 3u;
    uint dstBase = globalIdx * 3u;

    // Write to scanData[] as temporary storage
    // First region: compacted indices, second region: compacted posIndices
    uint posOffset = triangleCount * 3u;

    scanData[dstBase + 0u] = indices[srcBase + 0u];
    scanData[dstBase + 1u] = indices[srcBase + 1u];
    scanData[dstBase + 2u] = indices[srcBase + 2u];

    scanData[posOffset + dstBase + 0u] = posIndices[srcBase + 0u];
    scanData[posOffset + dstBase + 1u] = posIndices[srcBase + 1u];
    scanData[posOffset + dstBase + 2u] = posIndices[srcBase + 2u];
}
