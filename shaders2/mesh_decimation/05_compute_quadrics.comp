#version 460
#extension GL_EXT_shader_atomic_int64 : require

// ============================================================================
// Pass 5: Compute Per-Vertex Quadric Error Matrices
//
// Dispatch: ceil(triangleCount / WORKGROUP_SIZE) workgroups
// 1 thread per triangle.
//
// For each triangle, computes the plane equation and its fundamental quadric
// matrix weighted by sqrt(area), then accumulates it into each vertex's
// quadric via a workgroup-local shared-memory hash map. The shared map is
// flushed to global memory once per workgroup, converting O(3T) global
// atomics into O(V_unique) global atomics per workgroup.
//
// Also detects boundary edges and flags vertices (using global memory
// directly, since boundary edges are rare).
//
// Prerequisites:
//   - quadricsData[] must be cleared to 0 before dispatch.
//   - posIndices[] (PB) must be populated.
//   - edgeHashMap[], edgeTriangles[] from Pass 4.
//
// Result:
//   quadricsData[v*QUADRIC_FIELDS..] = sum of plane quadrics of all adjacent tris
//   vertexFlags: FLAG_BOUNDARY set on vertices of boundary edges
// ============================================================================

#include "common.glsl"
#include "bindings.glsl"

layout(local_size_x = WORKGROUP_SIZE) in;

// ============================================================================
// Shared-memory quadric accumulation
//
// 512-slot open-addressing hash map keyed by vertex index.
// Each slot: 1 uint key + QUADRIC_FIELDS ints (fixed-point).
// Total: 512 * (4 + 44) = 24 KB shared memory.
// Shared-memory atomics are ~20x faster than global on NVIDIA/AMD.
// ============================================================================

#define SMAP_SIZE 512u
#define SMAP_MASK (SMAP_SIZE - 1u)
#define SMAP_MAX_PROBE 32u

shared uint smapKey[SMAP_SIZE];
shared int  smapVal[SMAP_SIZE * QUADRIC_FIELDS];

void smapAdd(uint vertIdx, Quadric qr) {
    uint h = vertIdx & SMAP_MASK;
    for (uint p = 0u; p < SMAP_MAX_PROBE; p++) {
        uint s = (h + p) & SMAP_MASK;
        uint prev = atomicCompSwap(smapKey[s], NONE, vertIdx);
        if (prev == NONE || prev == vertIdx) {
            uint base = s * uint(QUADRIC_FIELDS);
            for (int i = 0; i < QUADRIC_FIELDS; i++) {
                atomicAdd(smapVal[base + uint(i)], int(round(qr.q[i] * QUADRIC_SCALE)));
            }
            return;
        }
    }
    atomicAddQuadric(vertIdx, qr);
}

// ============================================================================

bool isEdgeBoundary(uint v0, uint v1, uint hmMask) {
    uint eMin = min(v0, v1);
    uint eMax = max(v0, v1);
    uint key = hash_edge(eMin, eMax) & hmMask;

    for (uint probe = 0u; probe < MAX_PROBES; probe++) {
        uint s = (key + probe) & hmMask;
        if (edgeHashMap[s].x == eMin && edgeHashMap[s].y == eMax) {
            uint edgeIdx = edgeHashMap[s].z;
            return edgeTriangles[edgeIdx * 2u + 1u] == NONE;
        }
        if (edgeHashMap[s].x == HASHMAP_EMPTY) return false;
    }
    return false;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;

    // --- Initialize shared map (all threads participate, skip for paper mode) ---
    if (costMode != COST_MODE_PAPER) {
        for (uint t = tid; t < SMAP_SIZE; t += WORKGROUP_SIZE)
            smapKey[t] = NONE;
        uint totalVals = SMAP_SIZE * uint(QUADRIC_FIELDS);
        for (uint t = tid; t < totalVals; t += WORKGROUP_SIZE)
            smapVal[t] = 0;
    }
    barrier();

    // --- Load triangle, compute face quadric, accumulate in shared map ---
    uint actualTriCount = counters[COUNTER_TRIANGLE_COUNT];
    bool valid = (gid < actualTriCount);
    bool nonDegenerate = false;

    uint i0, i1, i2;
    vec3 p0, p1, p2;
    vec4 plane;
    float area2;

    if (valid) {
        uint baseIdx = gid * 3u;
        i0 = posIndices[baseIdx + 0u];
        i1 = posIndices[baseIdx + 1u];
        i2 = posIndices[baseIdx + 2u];

        p0 = loadVertex(i0).pos;
        p1 = loadVertex(i1).pos;
        p2 = loadVertex(i2).pos;

        vec3 edge1 = p1 - p0;
        vec3 edge2 = p2 - p0;
        vec3 n = cross(edge1, edge2);
        area2 = length(n);

        nonDegenerate = (area2 >= 1e-12);

        if (nonDegenerate) {
            n /= area2;
            float d = -dot(n, p0);
            plane = vec4(n, d);

            if (costMode != COST_MODE_PAPER) {
                Quadric qr = quadric_from_plane(plane);
                float weight = sqrt(area2 * 0.5);
                for (int i = 0; i < 10; i++) qr.q[i] *= weight;
                qr.q[10] = weight;

                smapAdd(i0, qr);
                smapAdd(i1, qr);
                smapAdd(i2, qr);
            }
        }
    }

    // --- Flush shared map to global (all threads participate, skip for paper mode) ---
    barrier();
    if (costMode != COST_MODE_PAPER) {
        for (uint t = tid; t < SMAP_SIZE; t += WORKGROUP_SIZE) {
            if (smapKey[t] != NONE) {
                uint vertIdx = smapKey[t];
                uint gBase = vertIdx * uint(QUADRIC_FIELDS);
                uint sBase = t * uint(QUADRIC_FIELDS);
                for (int i = 0; i < QUADRIC_FIELDS; i++) {
                    atomicAdd(quadricsData[gBase + uint(i)], smapVal[sBase + uint(i)]);
                }
            }
        }
    }

    // --- Initialize triangle descriptor for atomic-min scatter (fused P7) ---
    if (gid < actualTriCount) {
        triDescriptor[gid] = 0xFFFFFFFFFFFFFFFFul;
    }

    // --- Boundary detection (global memory, only valid non-degenerate triangles) ---
    if (!valid || !nonDegenerate) return;

    uint mask = hashMapSize - 1u;
    if (isEdgeBoundary(i0, i1, mask)) {
        atomicOr(vertexFlags[i0], FLAG_BOUNDARY);
        atomicOr(vertexFlags[i1], FLAG_BOUNDARY);
        if (costMode == COST_MODE_MESHOPT) {
            float ew = 10.0;
            Quadric bq = quadric_from_triangle_edge(p0, p1, p2, ew);
            Quadric fq = quadric_from_plane(plane);
            float fw = sqrt(area2 * 0.5) * ew;
            for (int i = 0; i < 10; i++) fq.q[i] *= fw;
            fq.q[10] = 0.0;
            bq = quadric_add(bq, fq);
            atomicAddQuadric(i0, bq);
            atomicAddQuadric(i1, bq);
        }
    }
    if (isEdgeBoundary(i1, i2, mask)) {
        atomicOr(vertexFlags[i1], FLAG_BOUNDARY);
        atomicOr(vertexFlags[i2], FLAG_BOUNDARY);
        if (costMode == COST_MODE_MESHOPT) {
            float ew = 10.0;
            Quadric bq = quadric_from_triangle_edge(p1, p2, p0, ew);
            Quadric fq = quadric_from_plane(plane);
            float fw = sqrt(area2 * 0.5) * ew;
            for (int i = 0; i < 10; i++) fq.q[i] *= fw;
            fq.q[10] = 0.0;
            bq = quadric_add(bq, fq);
            atomicAddQuadric(i1, bq);
            atomicAddQuadric(i2, bq);
        }
    }
    if (isEdgeBoundary(i2, i0, mask)) {
        atomicOr(vertexFlags[i2], FLAG_BOUNDARY);
        atomicOr(vertexFlags[i0], FLAG_BOUNDARY);
        if (costMode == COST_MODE_MESHOPT) {
            float ew = 10.0;
            Quadric bq = quadric_from_triangle_edge(p2, p0, p1, ew);
            Quadric fq = quadric_from_plane(plane);
            float fw = sqrt(area2 * 0.5) * ew;
            for (int i = 0; i < 10; i++) fq.q[i] *= fw;
            fq.q[10] = 0.0;
            bq = quadric_add(bq, fq);
            atomicAddQuadric(i2, bq);
            atomicAddQuadric(i0, bq);
        }
    }
}
