#version 460
#extension GL_EXT_shader_atomic_int64 : require

// ============================================================================
// Pass 3b: Scatter Adjacency Entries into Flat CSR Array (phase 2)
//
// Dispatch: ceil(triangleCount / WORKGROUP_SIZE) workgroups
// 1 thread per triangle.
//
// For each triangle, atomically claims a write position in the flat
// adjacency array for each of its 3 vertices and writes the packed
// (triIdx, slot) entry there.
//
// Prerequisites:
//   - adjHead[] must contain exclusive prefix-sum offsets (from host).
//   - triEdges[] must contain a copy of adjHead[] (write positions).
//   - posIndices[] (PB) populated.
//
// Result:
//   triAdjNext[offset..] = packed(triIdx, slot) entries, contiguous per vertex
//   triEdges[v] = adjHead[v] + count_v (end offset for vertex v)
// ============================================================================

#include "common.glsl"
#include "bindings.glsl"

layout(local_size_x = WORKGROUP_SIZE) in;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= triangleCount) return;

    uint baseIdx = gid * 3u;

    for (uint k = 0u; k < 3u; k++) {
        uint vertIdx = posIndices[baseIdx + k];
        uint pos = atomicAdd(valence[vertIdx], 1u);
        triAdjNext[pos] = ADJ_PACK(gid, k);
    }
}
