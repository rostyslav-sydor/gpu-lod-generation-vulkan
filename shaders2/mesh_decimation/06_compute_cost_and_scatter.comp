#version 460
#extension GL_EXT_shader_atomic_int64 : require

// ============================================================================
// Pass 6 (fused): Compute Edge Cost + Scatter to Triangle Descriptors
//
// Dispatch: ceil(edgeCount / WORKGROUP_SIZE) workgroups
// 1 thread per edge.
//
// Fuses the old Pass 6 (compute_edge_cost) + Pass 8 (select_candidates)
// into a single kernel. For each edge:
//   1. Compute QEM/paper/meshopt cost and optimal position
//   2. If eligible, immediately scatter via atomicMin to adjacent triangles
//
// This eliminates one dispatch + barrier + redundant buffer reads.
//
// Prerequisites:
//   - quadricsData[] populated from Pass 5
//   - triDescriptor[] initialized to MAX from Pass 5 (fused P7)
//   - edges[], edgeTriangles[] from Pass 4
//   - adjHead[], triAdjNext[] from Pass 3
//
// Result:
//   edgeCost[e], edgeFlags[e], edgeTarget[e] as before
//   triDescriptor[t] = descriptor of lowest-cost eligible edge nearby
// ============================================================================

#include "common.glsl"
#include "bindings.glsl"

layout(local_size_x = WORKGROUP_SIZE) in;

uint countAdjacent(uint vertIdx) {
    uint count = 0u;
    uint idx = adjHead[vertIdx];
    while (idx != NONE) { count++; idx = triAdjNext[idx]; }
    return count;
}

bool checkFlips(uint vertIdx, vec3 oldPos, uint otherVert, vec3 newPos) {
    uint idx = adjHead[vertIdx];
    while (idx != NONE) {
        uint triIdx = idx / 3u;
        uint i0 = indices[triIdx * 3u + 0u];
        uint i1 = indices[triIdx * 3u + 1u];
        uint i2 = indices[triIdx * 3u + 2u];

        if (i0 != otherVert && i1 != otherVert && i2 != otherVert) {
            vec3 pa, pb;
            if      (i0 == vertIdx) { pa = loadVertex(i1).pos; pb = loadVertex(i2).pos; }
            else if (i1 == vertIdx) { pa = loadVertex(i0).pos; pb = loadVertex(i2).pos; }
            else                    { pa = loadVertex(i0).pos; pb = loadVertex(i1).pos; }

            vec3 oldN = cross(pa - oldPos,  pb - oldPos);
            vec3 newN = cross(pa - newPos,  pb - newPos);

            if (dot(oldN, newN) <= 0.25 * sqrt(dot(oldN, oldN) * dot(newN, newN))) return false;
        }
        idx = triAdjNext[idx];
    }
    return true;
}

float solveQEM(Quadric qe, vec3 p0, vec3 p1, out vec3 optPos) {
    vec3 mid = (p0 + p1) * 0.5;
    float edgeLen = length(p1 - p0);
    float cost;

    bool invertible = quadric_optimal(qe, optPos);
    if (invertible && length(optPos - mid) > edgeLen) {
        invertible = false;
    }

    if (invertible) {
        cost = quadric_evaluate(qe, optPos);
    } else {
        float c0 = quadric_evaluate(qe, p0);
        float c1 = quadric_evaluate(qe, p1);
        float cm = quadric_evaluate(qe, mid);
        if (c0 <= c1 && c0 <= cm)      { cost = c0; optPos = p0; }
        else if (c1 <= cm)              { cost = c1; optPos = p1; }
        else                            { cost = cm; optPos = mid; }
    }
    return max(cost, 0.0);
}

vec3 getTriNormal(uint triIdx) {
    vec3 a = loadVertex(indices[triIdx * 3u + 0u]).pos;
    vec3 b = loadVertex(indices[triIdx * 3u + 1u]).pos;
    vec3 c = loadVertex(indices[triIdx * 3u + 2u]).pos;
    return cross(b - a, c - a);
}

void scatterToAdjacentTris(uint vertIdx, uint64_t descriptor) {
    uint idx = adjHead[vertIdx];
    while (idx != NONE) {
        uint triIdx = idx / 3u;
        atomicMin(triDescriptor[triIdx], descriptor);
        idx = triAdjNext[idx];
    }
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint actualEdgeCount = counters[COUNTER_EDGE_COUNT];
    if (gid >= actualEdgeCount) return;

    uvec2 edge = edges[gid];
    uint v0 = edge.x;
    uint v1 = edge.y;

    uint flags0 = vertexFlags[v0];
    uint flags1 = vertexFlags[v1];

    uint eFlags = 0u;
    uint eTri0 = edgeTriangles[gid * 2u + 0u];
    uint eTri1 = edgeTriangles[gid * 2u + 1u];
    bool isBoundary = (eTri1 == NONE);
    if (isBoundary) eFlags |= EDGE_BOUNDARY;

    uint valence0 = countAdjacent(v0);
    uint valence1 = countAdjacent(v1);
    if ((valence0 + valence1) > 24u) {
        edgeCost[gid] = 1e30;
        edgeFlags[gid] = eFlags;
        return;
    }

    Vertex vert0 = loadVertex(v0);
    Vertex vert1 = loadVertex(v1);
    vec3 mid = (vert0.pos + vert1.pos) * 0.5;
    float edgeLen = length(vert1.pos - vert0.pos);

    float costPenalty = 1.0;
    bool disc0 = (flags0 & FLAG_DISCONTINUITY) != 0u;
    bool disc1 = (flags1 & FLAG_DISCONTINUITY) != 0u;
    bool bnd0  = (flags0 & FLAG_BOUNDARY) != 0u;
    bool bnd1  = (flags1 & FLAG_BOUNDARY) != 0u;
    if (disc0 != disc1) costPenalty *= 100.0;
    if (bnd0 != bnd1)   costPenalty *= 100.0;
    if (isBoundary && !(bnd0 && bnd1)) costPenalty *= 100.0;

    vec3 optPos;
    float cost;

    if (costMode == COST_MODE_QEM) {
        Quadric qe = quadric_add(loadQuadric(v0), loadQuadric(v1));
        cost = solveQEM(qe, vert0.pos, vert1.pos, optPos) * costPenalty;
    }
    else if (costMode == COST_MODE_PAPER) {
        float dihedralCost = 1.0;
        if (eTri0 != NONE && eTri1 != NONE) {
            vec3 n0 = getTriNormal(eTri0);
            vec3 n1 = getTriNormal(eTri1);
            float len0 = length(n0);
            float len1 = length(n1);
            if (len0 > 1e-12 && len1 > 1e-12) {
                float cosA = dot(n0, n1) / (len0 * len1);
                dihedralCost = 1.0 - clamp(cosA, -1.0, 1.0);
            }
        }
        float idealValence = 6.0;
        float mergedValence = float(valence0 + valence1) - 2.0;
        float valenceDev = abs(mergedValence - idealValence) / idealValence;
        cost = dihedralCost * edgeLen * (1.0 + valenceDev) * costPenalty;
        optPos = mid;
    }
    else {
        Quadric q0 = loadQuadric(v0);
        Quadric q1 = loadQuadric(v1);
        float w0 = max(q0.q[10], 1e-6);
        float w1 = max(q1.q[10], 1e-6);
        float e0to1 = abs(quadric_evaluate(q0, vert1.pos)) / w0;
        float e1to0 = abs(quadric_evaluate(q1, vert0.pos)) / w1;
        if (e0to1 <= e1to0) {
            cost = e0to1 * costPenalty;
            optPos = vert1.pos;
        } else {
            cost = e1to0 * costPenalty;
            optPos = vert0.pos;
        }
    }

    if (costMode != COST_MODE_PAPER && cost >= costThreshold) {
        edgeCost[gid] = cost;
        edgeFlags[gid] = eFlags;
        return;
    }

    if (!checkFlips(v0, vert0.pos, v1, optPos) ||
        !checkFlips(v1, vert1.pos, v0, optPos)) {
        edgeCost[gid] = 1e30;
        edgeFlags[gid] = eFlags;
        return;
    }

    // --- Edge is eligible: write cost/target AND scatter to triangles ---
    edgeCost[gid] = cost;
    eFlags |= EDGE_ELIGIBLE;
    edgeFlags[gid] = eFlags;
    atomicAdd(counters[COUNTER_VERTEX_COUNT], 1u);

    float t = (edgeLen > 1e-10) ? clamp(length(optPos - vert0.pos) / edgeLen, 0.0, 1.0) : 0.5;
    vec3 optNormal = normalize(mix(vert0.normal, vert1.normal, t));
    vec2 optTexCoord = mix(vert0.texCoord, vert1.texCoord, t);

    edgeTarget[gid * 3u + 0u] = vec4(optPos, 0.0);
    edgeTarget[gid * 3u + 1u] = vec4(optNormal, 0.0);
    edgeTarget[gid * 3u + 2u] = vec4(optTexCoord, 0.0, 0.0);

    // --- Fused scatter: atomicMin to all adjacent triangles of both endpoints ---
    if (((flags0 | flags1) & FLAG_COLLAPSED) != 0u) return;

    uint costBits = quantizeCostBits(cost, costQuantBits);
    uint64_t descriptor = (uint64_t(costBits) << 32) | uint64_t(gid);

    scatterToAdjacentTris(v0, descriptor);
    scatterToAdjacentTris(v1, descriptor);
}
