#version 460
#extension GL_EXT_shader_atomic_int64 : require

// ============================================================================
// Pass 9: Check Winners and Perform Edge Collapse
//
// Dispatch: ceil(edgeCount / WORKGROUP_SIZE) workgroups
// 1 thread per edge.
//
// For each ELIGIBLE edge, checks whether it "won" the atomic-min race in
// ALL adjacent triangles. If triDescriptor[t] matches this edge's descriptor
// for every adjacent triangle, the edge is safe to collapse without
// interfering with any other collapse operation.
//
// Collapse action:
//   - Merge vertex v1 into v0 at the optimal position from Pass 6
//   - Update posIndices: replace v1 with v0 in all adjacent triangles of v1
//   - Mark v1 as COLLAPSED
//   - Increment collapse counter
//
// Prerequisites:
//   - triDescriptor[] from Pass 8
//   - edgeTarget[] from Pass 6
//   - All topology buffers
//
// Result:
//   - Vertices and indices updated with collapse operations
//   - Some triangles become degenerate (2+ identical vertices)
//   - counters[COUNTER_COLLAPSE_COUNT] = number of edges collapsed
// ============================================================================

#include "common.glsl"
#include "bindings.glsl"

layout(local_size_x = WORKGROUP_SIZE) in;

bool checkVertex(uint vertIdx, uint64_t descriptor) {
    uint idx = adjHead[vertIdx];
    while (idx != NONE) {
        uint triIdx = idx / 3u;
        if (triDescriptor[triIdx] != descriptor)
            return false;
        idx = triAdjNext[idx];
    }
    return true;
}

void markDirtyRing(uint vertIdx, uint dirtyGen) {
    posMap[vertIdx] = dirtyGen;
    uint idx = adjHead[vertIdx];
    while (idx != NONE) {
        uint triIdx = idx / 3u;
        uint base = triIdx * 3u;
        for (uint k = 0u; k < 3u; k++)
            posMap[posIndices[base + k]] = dirtyGen;
        idx = triAdjNext[idx];
    }
}

void replaceInAdjacent(uint oldVert, uint newVert) {
    uint idx = adjHead[oldVert];
    while (idx != NONE) {
        uint triIdx = idx / 3u;
        uint slot   = idx % 3u;
        uint base   = triIdx * 3u;

        posIndices[base + slot] = newVert;
        indices[base + slot] = newVert;
        idx = triAdjNext[idx];
    }
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint actualEdgeCount = counters[COUNTER_EDGE_COUNT];
    if (gid >= actualEdgeCount) return;
    if (counters[COUNTER_ALIVE_ESTIMATE] <= targetTriCount) return;

    if ((edgeFlags[gid] & EDGE_ELIGIBLE) == 0u) return;

    uvec2 edge = edges[gid];
    uint v0 = edge.x;
    uint v1 = edge.y;

    if (((vertexFlags[v0] | vertexFlags[v1]) & FLAG_COLLAPSED) != 0u) return;

    float cost = edgeCost[gid];
    uint costBits = quantizeCostBits(cost, costQuantBits);
    uint64_t descriptor = (uint64_t(costBits) << 32) | uint64_t(gid);

    // Check if we won the race for ALL adjacent triangles of BOTH vertices
    bool wonV0 = checkVertex(v0, descriptor);
    bool wonV1 = checkVertex(v1, descriptor);

    if (!wonV0 || !wonV1) return;

    // --- We won! Perform the collapse: merge v1 into v0 ---

    // Update v0 to the optimal position
    vec4 optPos      = edgeTarget[gid * 3u + 0u];
    vec4 optNormal   = edgeTarget[gid * 3u + 1u];
    vec4 optTexCoord = edgeTarget[gid * 3u + 2u];

    Vertex newVert;
    newVert.pos      = optPos.xyz;
    newVert.normal   = optNormal.xyz;
    newVert.texCoord = optTexCoord.xy;
    storeVertex(v0, newVert);

    // Replace v1 with v0 in all adjacent triangles of v1
    replaceInAdjacent(v1, v0);

    // Mark v1 as collapsed
    atomicOr(vertexFlags[v1], FLAG_COLLAPSED);

    // Mark 1-ring of both endpoints dirty for next iteration's pass 6
    uint dirtyGen = iteration + 1u;
    markDirtyRing(v0, dirtyGen);
    markDirtyRing(v1, dirtyGen);

    // Append to collapsed-edges list (reuses scanData[] as append buffer)
    // and increment collapse counter in one shot
    uint collapseIdx = atomicAdd(counters[COUNTER_COLLAPSE_COUNT], 1u);
    scanData[collapseIdx] = gid;
}
